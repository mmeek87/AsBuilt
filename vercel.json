{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": { "api/index.ts": { "maxDuration": 240, "includeFiles": "server/*.mjs" } },
  "rewrites": [
    {"source":"/api/:path*","destination":"/api/index"},
    {"source":"/evidence/:path*","destination":"/api/index"},
    {"source":"/mcp","destination":"/api/index"}
  ],
  "headers": [{"source":"/(.*)","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"}
  ]}]
}
