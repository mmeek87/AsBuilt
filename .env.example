# Copy to .env; Node loads it using: node --env-file=.env --import tsx server/index.ts
PORT=4310
# Set a random 32+ character secret; otherwise a local token is generated in .data/token.
# ASBUILT_TOKEN=
# Where reports, screenshots, sessions and product reviews are stored (default .data).
# ASBUILT_DATA_DIR=.data
# Preview origins are an operator-controlled allowlist. Never add production.
# ASBUILT_PREVIEW_ORIGINS=https://your-preview.example.com
# Approved public live sites for read-only inspection only (no actions, no journeys).
# ASBUILT_PUBLIC_READONLY_ORIGINS=https://www.example.com
# GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_PRIVATE_KEY_PATH=/absolute/path/outside-repo/asbuilt.pem
# GITHUB_APP_SLUG=
# Optional comments. App also needs Pull requests: write permission.
GITHUB_ALLOW_COMMENTS=false

# Optional planning agent. Select a Responses API model with tool calling and structured outputs.
# OPENAI_API_KEY=
# ASBUILT_MODEL=

# External interactive previews require the isolated Docker worker; see docs/phase2.md.
ASBUILT_INTERACTIVE_PREVIEWS=false

# Optional external image directory prefixes only, never whole origins or scripts.
# ASBUILT_IMAGE_PREFIXES=https://your-image-cdn.example.com/project-assets/

# --- Used by MCP bridge / helper clients, not by the server itself ---
# ASBUILT_URL=http://127.0.0.1:4310        # local service origin for the stdio bridge
# ASBUILT_TOKEN_FILE=/absolute/path/.data/token  # read the key from a file instead of ASBUILT_TOKEN
# ASBUILT_HOME=/absolute/path/to/AsBuilt   # only for scripts/verify-approved-menu-mcp.ts

# Only if Playwright browsers live outside the default cache (CI, containers).
# PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
