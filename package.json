{
  "name": "asbuilt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:e2e": "playwright test",
    "eval": "tsx evals/run.ts",
    "mcp": "tsx server/stdio.ts",
    "format": "prettier --write src server tests *.ts *.json *.md",
    "mcp:check": "tsx scripts/check-mcp.ts",
    "mcp:check-flow": "tsx scripts/check-mcp-product-flow.ts",
    "plugin:package": "python3 scripts/package-plugin.py",
    "plugin:test": "node --test tests/plugin-helper.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0",
    "playwright": "^1.56.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "packageManager": "pnpm@11.25.0",
  "license": "MIT"
}
